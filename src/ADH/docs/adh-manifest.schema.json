{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adh.tomcreations.org/schemas/adh-manifest.schema.json",
  "title": "ADH Mod Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "manifestVersion",
    "id",
    "name",
    "version",
    "author",
    "description",
    "support",
    "install"
  ],
  "properties": {
    "manifestVersion": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9._-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "homepage": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "support": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "game",
        "gameVersions"
      ],
      "properties": {
        "game": {
          "type": "string",
          "const": "Aestik"
        },
        "gameVersions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "loaderVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "channel": {
          "type": "string",
          "enum": [
            "official",
            "unofficial"
          ]
        },
        "reviewedByAdh": {
          "type": "boolean"
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "createFolders",
        "copyFiles"
      ],
      "properties": {
        "createFolders": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/createFolderAction"
          }
        },
        "copyFiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/copyFileAction"
          }
        }
      }
    },
    "entrypoints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entrypoint"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "custom": {
      "type": "object"
    }
  },
  "$defs": {
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 260,
      "allOf": [
        {
          "not": {
            "pattern": "^([a-zA-Z]:|/|\\\\\\\\)"
          }
        },
        {
          "not": {
            "pattern": "(^|[\\\\/])\\.\\.([\\\\/]|$)"
          }
        }
      ]
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "source": {
          "type": "string",
          "enum": [
            "pip",
            "npm",
            "executable",
            "runtime"
          ]
        },
        "version": {
          "type": "string",
          "maxLength": 64
        },
        "required": {
          "type": "boolean",
          "default": true
        },
        "reviewedByAdh": {
          "type": "boolean",
          "default": false
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "createFolderAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/safeRelativePath"
        }
      }
    },
    "copyFileAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/safeRelativePath"
        },
        "to": {
          "$ref": "#/$defs/safeRelativePath"
        },
        "overwrite": {
          "type": "boolean",
          "default": true
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        }
      }
    },
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "path"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "dotnet-assembly",
            "content-pack"
          ]
        },
        "path": {
          "$ref": "#/$defs/safeRelativePath"
        }
      }
    }
  }
}
